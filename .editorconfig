[*]
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = false
insert_final_newline = false
indent_style = space
indent_size = 4


[*.cs]
# C# diagnostics
dotnet_diagnostic.CS1591.severity = none # Missing XML comment for publicly accessible symbol

# Mutability analysis
dotnet_diagnostic.MN0101.severity = error # Mutation not allowed
dotnet_diagnostic.MN0102.severity = error # Invocation not allowed
dotnet_diagnostic.MN0103.severity = error # Output value might be global

dotnet_diagnostic.MN0182.severity = error # Mutability configuration has multiple definitions for the same symbol
dotnet_diagnostic.MN0183.severity = error # Mutability configuration doesn't match a single symbol

# ------------------------------------------------------------------------------

# Wrapping/line options
# Note: The line length is *also* set in the .DotSettings
max_line_length = 150
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true
csharp_new_line_before_open_brace = accessors, events, indexers, local_functions, methods, properties, types
csharp_new_line_before_else = false
csharp_new_line_before_while = false
csharp_new_line_before_catch = false
csharp_new_line_before_finally = false
csharp_new_line_before_members_in_object_initializers = false
csharp_new_line_before_members_in_anonymous_types = false
csharp_new_line_between_query_expression_clauses = false
indent_style = tab
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels = flush_left
csharp_indent_case_contents_when_block = false
csharp_space_after_cast = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_before_colon_in_inheritance_clause = true
csharp_space_after_colon_in_inheritance_clause = true
csharp_space_around_binary_operators = before_and_after
csharp_space_after_comma = true
csharp_space_after_semicolon_in_for_statement = true
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_prefer_braces = true:warning
csharp_style_namespace_declarations = file_scoped
dotnet_style_namespace_match_folder = false
csharp_style_expression_bodied_methods = true

dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.pascal_case_style.word_separator = _
dotnet_naming_style.pascal_case_with_I_style.capitalization = pascal_case
dotnet_naming_style.pascal_case_with_I_style.word_separator = _
dotnet_naming_style.pascal_case_with_I_style.required_prefix = I
dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.camel_case_style.word_separator = _
dotnet_naming_style.camel_case_with_c_style.capitalization = camel_case
dotnet_naming_style.camel_case_with_c_style.word_separator = _
dotnet_naming_style.camel_case_with_m_style.capitalization = camel_case
dotnet_naming_style.camel_case_with_m_style.word_separator = _
dotnet_naming_style.camel_case_with_m_style.required_prefix = m_
dotnet_naming_style.camel_case_with_c_style.required_prefix = c_
dotnet_naming_style.camel_case_with_s_style.capitalization = camel_case
dotnet_naming_style.camel_case_with_s_style.word_separator = _
dotnet_naming_style.camel_case_with_s_style.required_prefix = s_
dotnet_naming_symbols.most_symbols.applicable_kinds = namespace, class, struct, enum, property, method, event, delegate, local_function
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, internal, protected, protected_internal, private_protected
dotnet_naming_symbols.local_field_and_parameters.applicable_kinds = parameter, field
dotnet_naming_symbols.local_field_and_parameters.applicable_accessibilities = local
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_symbols.const_private_fields.applicable_kinds = field
dotnet_naming_symbols.const_private_fields.applicable_accessibilities = private
dotnet_naming_symbols.const_private_fields.required_modifiers = const
dotnet_naming_symbols.static_private_fields.applicable_kinds = field
dotnet_naming_symbols.static_private_fields.applicable_accessibilities = private
dotnet_naming_symbols.static_private_fields.required_modifiers = static
dotnet_naming_rule.most_symbols_are_pascal_case.symbols = most_symbols
dotnet_naming_rule.most_symbols_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.most_symbols_are_pascal_case.severity = warning

dotnet_naming_rule.interface_symbol_are_pascal_case_with_prefix.symbols = interface_symbols
dotnet_naming_rule.interface_symbol_are_pascal_case_with_prefix.style = pascal_case_with_I_style
dotnet_naming_rule.interface_symbol_are_pascal_case_with_prefix.severity = warning

dotnet_naming_rule.non_private_fields_are_pascal_case.symbols = non_private_fields
dotnet_naming_rule.non_private_fields_are_pascal_case.style = pascal_case_style
dotnet_naming_rule.non_private_fields_are_pascal_case.severity = warning

dotnet_naming_rule.local_fields_and_parameters_are_camel_case.symbols = local_field_and_parameters
dotnet_naming_rule.local_fields_and_parameters_are_camel_case.style = camel_case_style
dotnet_naming_rule.local_fields_and_parameters_are_camel_case.severity = warning

dotnet_naming_rule.private_fields_are_camel_case_with_prefix.symbols = private_fields
dotnet_naming_rule.private_fields_are_camel_case_with_prefix.style = camel_case_with_m_style
dotnet_naming_rule.private_fields_are_camel_case_with_prefix.severity = warning

dotnet_naming_rule.const_private_fields_are_camel_case_with_prefix.symbols = const_private_fields
dotnet_naming_rule.const_private_fields_are_camel_case_with_prefix.style = camel_case_with_c_style
dotnet_naming_rule.const_private_fields_are_camel_case_with_prefix.severity = warning

dotnet_naming_rule.static_private_fields_are_camel_case_with_prefix.symbols = static_private_fields
dotnet_naming_rule.static_private_fields_are_camel_case_with_prefix.style = camel_case_with_s_style
dotnet_naming_rule.static_private_fields_are_camel_case_with_prefix.severity = warning

resharper_autodetect_indent_settings = true
resharper_formatter_off_tag = @formatter:off
resharper_formatter_on_tag = @formatter:on
resharper_formatter_tags_enabled = true
resharper_use_indent_from_vs = false
resharper_arrange_redundant_parentheses_highlighting = hint
resharper_arrange_this_qualifier_highlighting = hint
resharper_arrange_type_member_modifiers_highlighting = hint
resharper_arrange_type_modifiers_highlighting = hint
resharper_built_in_type_reference_style_for_member_access_highlighting = hint
resharper_built_in_type_reference_style_highlighting = hint
resharper_cpp_declarator_never_used_highlighting = suggestion
resharper_mvc_action_not_resolved_highlighting = warning
resharper_mvc_area_not_resolved_highlighting = warning
resharper_mvc_controller_not_resolved_highlighting = warning
resharper_mvc_masterpage_not_resolved_highlighting = warning
resharper_mvc_partial_view_not_resolved_highlighting = warning
resharper_mvc_template_not_resolved_highlighting = warning
resharper_mvc_view_component_not_resolved_highlighting = warning
resharper_mvc_view_component_view_not_resolved_highlighting = warning
resharper_mvc_view_not_resolved_highlighting = warning
resharper_razor_assembly_not_resolved_highlighting = warning
resharper_redundant_base_qualifier_highlighting = warning
resharper_suggest_var_or_type_built_in_types_highlighting = hint
resharper_suggest_var_or_type_elsewhere_highlighting = hint
resharper_suggest_var_or_type_simple_types_highlighting = hint
resharper_web_config_module_not_resolved_highlighting = warning
resharper_web_config_type_not_resolved_highlighting = warning
resharper_web_config_wrong_module_highlighting = warning

[*.{appxmanifest,asax,ascx,aspx,axaml,blockshader,c,c++,c++m,cc,ccm,cginc,compute,cp,cpp,cppm,cs,cshtml,cu,cuh,cxx,cxxm,dtd,fs,fsi,fsscript,fsx,fx,fxh,h,h++,hh,hlsl,hlsli,hlslinc,hp,hpp,hxx,icc,inc,inl,ino,ipp,ispc,isph,ixx,master,ml,mli,mpp,mq4,mq5,mqh,mxx,nuspec,paml,pssl,pssli,razor,resw,resx,shader,shaderFoundry,skin,tcc,tpp,urtshader,usf,ush,uxml,vb,xaml,xamlx,xoml,xsd}]
indent_style = space
indent_size = 4
tab_width = 4
